<?xml version="1.0"?>
<robot name="warehouse_bot">
    <link name="base_footprint"/>
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.03416667" ixy="0.0" ixz="-0.02500000" iyy="0.09666667" iyz="0.0" izz="0.10416667"/>
    </inertial>
    <visual>
      <geometry>
        <box size="0.5 0.5 0.2"/>
      </geometry>
      <origin xyz="0.25 0 0.1" rpy="0 0 0"/>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.5 0.5 0.2"/>
      </geometry>
      <origin xyz="0.25 0 0.1" rpy="0 0 0"/>
    </collision>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>
  <link name="laser_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.00145833" ixy="0.0" ixz="0.0" iyy="0.00145833" iyz="0.0" izz="0.00125000"/>
    </inertial>
    <visual>
        <geometry>
            <cylinder length="0.1" radius="0.05"/>
        </geometry>
        <origin xyz="0 0 0.0" rpy="0 0 0"/>
        <material name="red">
            <color rgba="1 0 0 1"/>
        </material>
    </visual>
    <collision>
        <geometry>
            <cylinder length="0.1" radius="0.05"/>
        </geometry>
        <origin xyz="0 0 0.0" rpy="0 0 0"/>
    </collision>
  </link>
<joint name="lidar_joint" type="fixed">
    <parent link ="base_link" />
    <child link="laser_link" />
    <origin xyz="0.25 0 0.25" rpy="0 0 0"/>
  </joint>
    <link name="left_wheel_link">
        <inertial>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <mass value="1.0"/>
          <inertia ixx="0.00500000" ixy="0.0" ixz="0.0" iyy="0.00270833" iyz="0.0" izz="0.00270833"/>
        </inertial>
        <visual>
            <geometry>
                <cylinder length="0.05" radius="0.1"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.05" radius="0.1"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
        </collision>
    </link>
    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel_link"/>
        <origin xyz="0 0.275 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>
    <link name="right_wheel_link">
        <inertial>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <mass value="1.0"/>
          <inertia ixx="0.00500000" ixy="0.0" ixz="0.0" iyy="0.00270833" iyz="0.0" izz="0.00270833"/>
        </inertial>
        <visual>
            <geometry>
                <cylinder length="0.05" radius="0.1"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder length="0.05" radius="0.1"/>
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0"/>
        </collision>
    </link>
    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel_link"/>
        <origin xyz="0 -0.275 0" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>
    <link name="castor_wheel_link">
        <inertial>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <mass value="0.5"/>
          <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
        </inertial>
        <visual>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.05"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>
    </link>
    <joint name="castor_wheel_joint" type="fixed">
        <parent link="base_link"/>
        <child link="castor_wheel_link"/>
        <origin xyz="0.375 0 -0.05" rpy="0 0 0"/>
    </joint>
  <ros2_control name="GazeboSimSystem" type="system">

    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin
      filename="libgz_ros2_control-system.so"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>
        /home/melvin/ihub_ws/install/warehouse_robot/share/warehouse_robot/config/controllers.yaml
      </parameters>
    </plugin>
  </gazebo>
<gazebo reference="laser_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>/scan</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <gz_frame_id>laser_link</gz_frame_id>
        <lidar>
            <scan>
                <horizontal>
                    <samples>720</samples>
                    <resolution>1</resolution>
                    <min_angle>-3.14159265</min_angle>
                    <max_angle>3.14159265</max_angle>
                </horizontal>
                <vertical>
                    <samples>1</samples>
                    <resolution>1</resolution>
                    <min_angle>0</min_angle>
                    <max_angle>0</max_angle>
                </vertical>
            </scan>
            <range>
                <min>0.10</min>
                <max>12.0</max>
                <resolution>0.01</resolution>
            </range>
        </lidar>
    </sensor>
</gazebo>
</robot>